{
  "name": "wikimasters-toolbox",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for WikiMasters",
  "license": "MIT",
  "author": "Noé Henchoz",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && tailwindcss -i src/toolbox.css -o dist/toolbox.css --minify && node scripts/build.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm build && pnpm test",
    "package": "pnpm check && node scripts/package.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/cli": "4.3.3",
    "semantic-release": "^25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
